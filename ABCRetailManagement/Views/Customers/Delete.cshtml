@model ABCRetailManagement.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="form-page">

    <div class="form-card">

        <p class="form-eyebrow">AZURE TABLE STORAGE</p>

        <h1 class="form-title">DELETE CUSTOMER</h1>

        <div class="mb-4">
            <p style="font-size: 12px; color: #6E6963;">
                Are you sure you want to delete this customer?
            </p>
        </div>

        <div class="form-group">
            <label class="form-label">Customer ID</label>

            <input value="@Model.CustomerId"
                   class="form-control"
                   readonly />
        </div>

        <div class="form-group">
            <label class="form-label">Name</label>

            <input value="@Model.Name"
                   class="form-control"
                   readonly />
        </div>

        <div class="form-group">
            <label class="form-label">Email</label>

            <input value="@Model.Email"
                   class="form-control"
                   readonly />
        </div>

        <form asp-action="Delete" method="post">

            <input type="hidden"
                   asp-for="CustomerId" />

            <div class="form-actions">

                <button type="submit"
                        class="form-primary form-danger">
                    Delete Customer
                </button>

                <a asp-action="Index"
                   class="form-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>