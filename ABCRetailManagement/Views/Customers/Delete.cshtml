@model ABCRetailManagement.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<h1>Delete Customer</h1>

<h4>Are you sure you want to delete this customer?</h4>

<div class="mb-3">
    <strong>Customer ID:</strong> @Model.CustomerId
</div>

<div class="mb-3">
    <strong>Name:</strong> @Model.Name
</div>

<div class="mb-3">
    <strong>Email:</strong> @Model.Email
</div>

<div class="mb-3">
    <strong>Phone:</strong> @Model.Phone
</div>

<div class="mb-3">
    <strong>Location:</strong> @Model.Location
</div>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="CustomerId" />

    <button type="submit" class="btn btn-danger">
        Delete Customer
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>