@model IEnumerable<ABCRetailManagement.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<h1>Customers</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Customer</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Customer ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Location</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.CustomerId</td>
                <td>@customer.Name</td>
                <td>@customer.Email</td>
                <td>@customer.Phone</td>
                <td>@customer.Location</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@customer.CustomerId">
                        Edit
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@customer.CustomerId">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>