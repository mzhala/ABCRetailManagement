@model ABCRetailManagement.Models.Order

@{
    ViewData["Title"] = "Delete Order";
}

<div class="form-page">

    <div class="form-card">

        <p class="form-eyebrow">AZURE QUEUE STORAGE</p>

        <h1 class="form-title">DELETE ORDER</h1>

        <h4 class="form-subtitle">
            Are you sure you want to delete this order?
        </h4>

        <div class="form-group">
            <strong>Order ID:</strong>
            @Model.OrderId
        </div>

        <div class="form-group">
            <strong>Customer:</strong>
            @Model.CustomerId
        </div>

        <div class="form-group">
            <strong>Product:</strong>
            @Model.ProductId
        </div>

        <div class="form-group">
            <strong>Quantity:</strong>
            @Model.Quantity
        </div>

        <div class="form-group">
            <strong>Status:</strong>
            @Model.Status
        </div>

        <form asp-action="Delete" method="post">

            <input type="hidden"
                   asp-for="OrderId" />

            <div class="form-actions">

                <button type="submit"
                        class="form-delete">
                    Delete Order
                </button>

                <a asp-action="Index"
                   class="form-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>