@model ABCRetailManagement.Models.Order

@{
    ViewData["Title"] = "Edit Order";
}

<div class="form-page">

    <div class="form-card">

        <p class="form-eyebrow">AZURE QUEUE STORAGE</p>

        <h1 class="form-title">EDIT ORDER</h1>

        <form asp-action="Edit" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <input type="hidden" asp-for="OrderId" />

            <div class="form-group">

                <label asp-for="CustomerId"
                       class="form-label">
                    Customer
                </label>

                <select asp-for="CustomerId"
                        class="form-control">

                    <option value="">
                        Select a customer
                    </option>

                    @foreach (var customer in ViewBag.Customers)
                    {
                        <option value="@customer.CustomerId">
                            @customer.CustomerId: @customer.Name
                        </option>
                    }

                </select>

                <span asp-validation-for="CustomerId"
                      class="field-validation-error"></span>

            </div>


            <div class="form-group">

                <label class="form-label">
                    Product
                </label>

                <input value="@Model.ProductId"
                       class="form-control"
                       readonly />

                <input type="hidden"
                       asp-for="ProductId" />

            </div>


            <div class="form-group">

                <label class="form-label">
                    Quantity
                </label>

                <input value="@Model.Quantity"
                       class="form-control"
                       readonly />

                <input type="hidden"
                       asp-for="Quantity" />

            </div>


            <div class="form-group">

                <label class="form-label">
                    Status
                </label>

                <input value="@Model.Status"
                       class="form-control"
                       readonly />

                <input type="hidden"
                       asp-for="Status" />

            </div>


            <div class="form-actions">

                <button type="submit"
                        class="form-primary">
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="form-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>