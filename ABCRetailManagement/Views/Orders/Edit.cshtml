@model ABCRetailManagement.Models.Order

@{
    ViewData["Title"] = "Edit Order";
}

<h1>Edit Order</h1>

<form asp-action="Edit" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <input type="hidden" asp-for="OrderId" />

    <div class="mb-3">
        <label asp-for="CustomerId" class="form-label">
            Customer
        </label>

        <select asp-for="CustomerId" class="form-select">
            <option value="">Select a customer</option>

            @foreach (var customer in ViewBag.Customers)
            {
                <option value="@customer.CustomerId">
                    @customer.CustomerId: @customer.Name
                </option>
            }
        </select>

        <span asp-validation-for="CustomerId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Product</label>

        <input value="@Model.ProductId"
               class="form-control"
               readonly />

        <input type="hidden" asp-for="ProductId" />
    </div>

    <div class="mb-3">
        <label class="form-label">Quantity</label>

        <input value="@Model.Quantity"
               class="form-control"
               readonly />

        <input type="hidden" asp-for="Quantity" />
    </div>

    <div class="mb-3">
        <label class="form-label">Status</label>

        <input value="@Model.Status"
               class="form-control"
               readonly />

        <input type="hidden" asp-for="Status" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>