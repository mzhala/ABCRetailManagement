@model IEnumerable<ABCRetailManagement.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<h1>Orders</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create Order
    </a>
</p>

<form asp-action="ProcessNext" method="post" class="mb-3">
    <button type="submit" class="btn btn-primary">
        Process Next Order
    </button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Product</th>
            <th>Quantity</th>
            <th>Status</th>
            <th>Order Date</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var order in Model)
        {
            var customer = ((IEnumerable<ABCRetailManagement.Models.Customer>)ViewBag.Customers)
            .FirstOrDefault(c => c.CustomerId == order.CustomerId);

            var product = ((IEnumerable<ABCRetailManagement.Models.Product>)ViewBag.Products)
            .FirstOrDefault(p => p.ProductId == order.ProductId);

            <tr>
                <td>@order.OrderId</td>

                <td>
                    @order.CustomerId : @(customer?.Name ?? "Unknown Customer")
                </td>

                <td>
                    @order.ProductId : @(product?.Name ?? "Unknown Product")
                </td>

                <td>@order.Quantity</td>

                <td>@order.Status</td>

                <td>
                    @order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@order.OrderId">
                        Edit
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@order.OrderId">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>