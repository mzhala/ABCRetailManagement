@model ABCRetailManagement.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="form-page">

    <div class="form-card">

        <p class="form-eyebrow">AZURE TABLE STORAGE</p>

        <h1 class="form-title">DELETE PRODUCT</h1>

        <p style="font-size: 12px; color: #6E6963; margin-bottom: 25px;">
            Are you sure you want to delete this product?
        </p>

        <div class="form-group">
            <label class="form-label">
                Product ID
            </label>

            <input value="@Model.ProductId"
                   class="form-control"
                   readonly />
        </div>

        <div class="form-group">
            <label class="form-label">
                Name
            </label>

            <input value="@Model.Name"
                   class="form-control"
                   readonly />
        </div>

        <div class="form-group">
            <label class="form-label">
                Category
            </label>

            <input value="@Model.Category"
                   class="form-control"
                   readonly />
        </div>

        <div class="form-group">
            <label class="form-label">
                Price
            </label>

            <input value="@Model.Price.ToString("0.00")"
                   class="form-control"
                   readonly />
        </div>

        <div class="form-group">
            <label class="form-label">
                Stock
            </label>

            <input value="@Model.Stock"
                   class="form-control"
                   readonly />
        </div>

        <form asp-action="Delete" method="post">

            <input type="hidden"
                   asp-for="ProductId" />

            <div class="form-actions">

                <button type="submit"
                        class="form-primary form-danger">
                    Delete Product
                </button>

                <a asp-action="Index"
                   class="form-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>