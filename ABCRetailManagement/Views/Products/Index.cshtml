@model IEnumerable<ABCRetailManagement.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add Product
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Product ID</th>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Image</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.Name</td>
                <td>@product.Category</td>
                <td>R @product.Price.ToString("N2")</td>
                <td>@product.Stock</td>
                <td>
                    @if (!string.IsNullOrEmpty(product.ImageName))
                    {
                        <img src="@Url.Action("Image", "Products", new { fileName = product.ImageName })"
                             alt="@product.Name"
                             width="80"
                             height="80" />
                    }
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@product.ProductId">
                        Edit
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@product.ProductId">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>