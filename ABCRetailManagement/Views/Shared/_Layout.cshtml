@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ABC Retail</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header class="site-header">
        <div class="header-inner">

            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-main">ABC</span>
                <span class="brand-sub">RETAIL</span>
            </a>

            <nav class="main-nav">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="@(currentController == "Home" ? "active" : "")">
                    Dashboard
                </a>

                <a asp-controller="Customers"
                   asp-action="Index"
                   class="@(currentController == "Customers" ? "active" : "")">
                    Customers
                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="@(currentController == "Products" ? "active" : "")">
                    Products
                </a>

                <a asp-controller="Orders"
                   asp-action="Index"
                   class="@(currentController == "Orders" ? "active" : "")">
                    Orders
                </a>

                <a asp-controller="Logs"
                   asp-action="Index"
                   class="@(currentController == "Logs" ? "active" : "")">
                    Logs
                </a>


            </nav>

            <div class="storage-status">
                <span class="status-dot"></span>
                Azure Storage connected
            </div>

        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">

        <div class="footer-inner">

            <div>
                <div class="footer-brand">
                    ABC <span>RETAIL</span>
                </div>

                <p>
                    A retail management system built on
                    Azure Table, Blob, Queue and File storage.
                </p>
            </div>

            <div class="footer-reference">
                ST10355256 · Halalisile Mzobe CLDV7112 · PROJECT 1
            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>